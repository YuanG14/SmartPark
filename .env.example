# Copy this file to .env.local and fill in your own Supabase project values.
# Get these from: Supabase Dashboard -> Project Settings -> API

# Safe to expose to the browser — protected by Row Level Security.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER put the service_role key in a VITE_ variable or any frontend file.
# The service role key only ever lives in Supabase Edge Function secrets.

# Authentication note:
# SmartPark currently uses local demo authentication in src/features/auth/AuthProvider.tsx.
# Supabase Auth is intentionally NOT used yet. These variables are still used by the
# existing Supabase database/data layer.
